# --- Database ---
DATABASE_URL=postgresql://clarity:clarity@localhost:5432/clarity
# Integration tests only (wiped on every test run)
DATABASE_URL_TEST=postgresql://clarity:clarity@localhost:5432/clarity_test

# --- Clarity Data Export API ---
CLARITY_API_TOKEN=
# true = read fixtures/clarity/*.json instead of calling Clarity (dev; never wastes real calls)
CLARITY_MOCK=false
CLARITY_DAILY_CALL_BUDGET=10
CLARITY_RESERVED_CALLS=2
# Minutes after IST midnight when Clarity's daily limit resets (undocumented; 330 = UTC midnight)
CLARITY_BUDGET_RESET_OFFSET_MINUTES=0

# --- Scheduling ---
CRON_SECRET=
CRON_SCHEDULE="30 0 * * *"
APP_TIMEZONE=Asia/Kolkata
APP_BASE_URL=

# --- Auth (Microsoft Entra ID) ---
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ADMIN_EMAILS=
VIEWER_EMAILS=
ALLOWED_EMAIL_DOMAIN=codebasics.io

# --- Alerts ---
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# --- Data handling ---
STRIP_URL_QUERY=true
RAW_RETENTION_DAYS=180
LOG_LEVEL=info
