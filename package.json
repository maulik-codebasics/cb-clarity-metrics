{
    "name": "cb-clarity-metrics",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "postinstall": "prisma generate",
        "etl:run": "tsx scripts/etl-run.ts",
        "etl:reprocess": "tsx scripts/etl-reprocess.ts",
        "etl:health": "tsx scripts/etl-health.ts",
        "etl:purge-raw": "tsx scripts/etl-purge-raw.ts",
        "db:migrate": "prisma migrate deploy",
        "db:migrate:dev": "prisma migrate dev",
        "db:seed": "prisma db seed",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "date-fns": "4.4.0",
        "date-fns-tz": "3.2.0",
        "next": "16.4.6",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "22.20.7",
        "@types/pg": "8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "18.0.10",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "10.1.8",
        "msw": "3.0.7",
        "prettier": "3.10.1",
        "prisma": "7.10.1",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "5.1.2"
    },
    "engines": {
        "node": ">=22"
    }
}
